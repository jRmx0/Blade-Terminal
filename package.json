{
  "name": "bun-react-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot server/index.ts",
    "build": "bun build ./src/index.html --outdir=dist --sourcemap --target=browser --minify --define:process.env.NODE_ENV='\"production\"' --env='BUN_PUBLIC_*'",
    "start": "NODE_ENV=production bun server/index.ts"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@headlessui/react": "^2.2.9",
    "@uiw/react-color": "^2.9.6",
    "bun-plugin-tailwind": "^0.1.2",
    "dexie": "^4.3.0",
    "konva": "^10.2.0",
    "react": "^19",
    "react-dom": "^19",
    "react-konva": "^19.2.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "uplot": "^1.6.32",
    "zundo": "^2.3.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.0.0"
  }
}
